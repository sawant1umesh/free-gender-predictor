---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | Chinese Gender Predictor"
  description="Page not found. Return to the free Chinese Gender Predictor tool to estimate your baby's gender using the traditional Chinese Gender Chart."
>
  <section class="py-24 px-4 sm:px-6 lg:px-8 max-w-2xl mx-auto text-center space-y-8">
    <div class="text-6xl font-extrabold text-gray-200">404</div>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Page Not Found</h1>
    <p class="text-gray-500 text-lg max-w-md mx-auto">
      The page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-xl font-semibold text-white shadow-lg shadow-pink-500/20 transition-all duration-300 hover:shadow-pink-500/35 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2 focus:ring-offset-white btn-primary px-6 py-3"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Back to Home
    </a>
  </section>
</BaseLayout>
