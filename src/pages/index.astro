---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import ResultExperience from '../components/result/ResultExperience.astro';
import CalendarSection from '../components/calendar/CalendarSection.astro';
import ConceptionPredictor from '../components/conception/ConceptionPredictor.astro';
import LatestBlogPosts from '../components/blog/LatestBlogPosts.astro';

const faqItems = [
  {
    question: "What is the Chinese Gender Predictor by Conception Date?",
    answer: "The Chinese Gender Predictor by conception date is a traditional calculation method rooted in the ancient Qing Gong Biao (清宫表) chart. It cross-references the mother's Chinese lunar age at conception with the Chinese lunar month of conception to estimate whether the baby will be a boy or a girl.",
  },
  {
    question: "How does the Chinese Gender Chart work?",
    answer: "The tool converts the mother's Gregorian date of birth and estimated conception date into astronomical Chinese lunar calendar dates. It calculates the mother's traditional lunar age (虚岁) based on Chinese New Year boundaries and identifies the lunar conception month, matching them on the 18–45 age matrix.",
  },
  {
    question: "What is Chinese Lunar Age (虚岁 - Xūsuì)?",
    answer: "In traditional Chinese culture, a newborn is considered 1 year old at birth, and age increments by +1 on each Chinese Lunar New Year (Spring Festival) rather than on individual birthdays. As a result, Chinese lunar age is typically 1 to 2 years higher than Western chronological age.",
  },
  {
    question: "Does the predictor use Gregorian or Chinese Lunar months?",
    answer: "The predictor strictly uses astronomical Chinese lunar months, not Gregorian calendar months. Because lunar months align with new moon phases and last 29 to 30 days, our calculator automatically translates your Gregorian conception date to the exact lunar month.",
  },
  {
    question: "Is the Chinese Gender Predictor scientifically accurate?",
    answer: "No. The Chinese Gender Predictor is a traditional cultural folklore tool with no scientific or medical validity. A baby's biological sex is determined at conception by chromosomes carried in the sperm (X for female, Y for male). Results should be treated purely as entertainment.",
  },
  {
    question: "Can I use an estimated conception date?",
    answer: "Yes. If you do not know the exact day of conception, you can enter an estimated date based on your ovulation window, last menstrual period (LMP + 14 days), or ultrasound dating provided by your healthcare provider.",
  },
  {
    question: "How are leap lunar months handled?",
    answer: "In years containing an intercalary Chinese leap month (闰月), traditional practice assigns the conception to the base lunar month number (for instance, Leap Month 4 corresponds to Month 4 on the chart) while clearly displaying the leap month designation in the result.",
  },
  {
    question: "When can medical tests reliably confirm baby gender?",
    answer: "A non-invasive prenatal cell-free DNA blood test (NIPT) can determine fetal sex as early as 10 weeks of pregnancy. A standard mid-pregnancy anatomy ultrasound scan typically confirms gender between 18 and 22 weeks with high clinical accuracy.",
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const webAppSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Chinese Gender Predictor by Conception Date",
  url: "https://freegenderpredictor.com",
  applicationCategory: "LifestyleApplication",
  operatingSystem: "All",
  browserRequirements: "Requires JavaScript. Requires HTML5.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description: "Free online Chinese Gender Predictor calculating traditional Chinese lunar age and lunar conception month based on the authentic Qing Gong Biao chart.",
});
---

<BaseLayout
  title="Chinese Gender Predictor by Conception Date - Free Lunar Chart Calculator"
  description="Use our free Chinese Gender Predictor by conception date and mother's birth date. Calculate traditional Chinese lunar age (虚岁) and lunar conception month on the Qing Gong Biao chart."
  includeOrg={true}
>
  <Fragment slot="head">
    <meta name="keywords" content="chinese gender predictor by conception date, chinese gender predictor, chinese gender chart, conception gender prediction, lunar age calculator, qing gong biao, baby gender prediction" />
    <script type="application/ld+json" set:html={faqSchema} />
    <script type="application/ld+json" set:html={webAppSchema} />
  </Fragment>

  <!-- Annual Overview Calculator & Results -->
  <HeroSection />
  <ResultExperience />
  <CalendarSection />

  <!-- Single Conception Date Predictor Tool -->
  <ConceptionPredictor />

  <!-- Educational SEO Content Sections -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-16">
    <!-- Introduction: What is the Chinese Gender Predictor -->
    <article class="space-y-5">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
        About the Chinese Gender Predictor by Conception Date
      </h2>
      <p class="text-gray-600 leading-relaxed">
        The <strong>Chinese Gender Predictor</strong> is one of the world's most famous traditional folklore methods for guessing baby gender. Originating during the Qing Dynasty and historically recorded in the imperial <em>Qing Gong Biao</em> (清宫表), this ancient chart maps the mother's lunar age against the lunar month of conception to predict whether a baby will be a boy or a girl.
      </p>
      <p class="text-gray-600 leading-relaxed">
        Unlike basic calculators that rely on modern Gregorian calendar dates, an authentic Chinese gender prediction requires converting both the mother's birth date and estimated conception date into the astronomical Chinese lunar calendar. Our calculator automates this complex astronomical conversion in real time, determining the mother's exact lunar age (虚岁) and lunar conception month.
      </p>
      <p class="text-gray-600 leading-relaxed">
        Learn more about our methods in our <a href="/about" class="text-pink-600 hover:text-pink-500 font-semibold underline underline-offset-2 transition-colors">About Us guide</a> or explore our comprehensive <a href="/faq" class="text-pink-600 hover:text-pink-500 font-semibold underline underline-offset-2 transition-colors">Chinese Gender Predictor FAQ</a>.
      </p>
    </article>

    <!-- How It Works Step-by-Step -->
    <article id="how-it-works" class="space-y-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
        How the Conception Gender Prediction Works
      </h2>
      <p class="text-gray-600 leading-relaxed">
        The calculation follows four precise steps to map your dates to the traditional Qing Gong Biao matrix:
      </p>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="card-light rounded-xl p-5 border border-gray-200 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-pink-100 text-pink-700 font-bold text-sm flex items-center justify-center">1</div>
          <h3 class="text-base font-bold text-gray-900">Enter Mother's Birth Date</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Your Gregorian date of birth is converted to your Chinese Lunar Birth Year, accounting for whether you were born before or after Chinese New Year (Spring Festival).
          </p>
        </div>

        <div class="card-light rounded-xl p-5 border border-gray-200 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-pink-100 text-pink-700 font-bold text-sm flex items-center justify-center">2</div>
          <h3 class="text-base font-bold text-gray-900">Enter Conception Date</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            The estimated conception date is converted to its Chinese Lunar Conception Year and astronomical Lunar Month (1 to 12), identifying any leap lunar months.
          </p>
        </div>

        <div class="card-light rounded-xl p-5 border border-gray-200 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-pink-100 text-pink-700 font-bold text-sm flex items-center justify-center">3</div>
          <h3 class="text-base font-bold text-gray-900">Calculate Traditional Lunar Age</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Your traditional lunar age (虚岁) is determined: <code>Conception Lunar Year - Birth Lunar Year + 1</code>. This accounts for time in the womb and lunar new year transitions.
          </p>
        </div>

        <div class="card-light rounded-xl p-5 border border-gray-200 space-y-2">
          <div class="w-8 h-8 rounded-lg bg-pink-100 text-pink-700 font-bold text-sm flex items-center justify-center">4</div>
          <h3 class="text-base font-bold text-gray-900">Cross-Reference the Chart</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            The intersection of your lunar age row (ages 18–45) and lunar conception month column provides the folklore prediction of Boy or Girl.
          </p>
        </div>
      </div>
    </article>

    <!-- Understanding the Result -->
    <article id="understanding-results" class="space-y-5">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
        Understanding Your Prediction Results
      </h2>
      <p class="text-gray-600 leading-relaxed">
        When using our <a href="#conception-predictor-section" class="text-pink-600 hover:text-pink-500 font-semibold underline underline-offset-2 transition-colors">Conception Predictor calculator</a>, the result card provides detailed cultural context:
      </p>

      <ul class="space-y-3 text-gray-600 leading-relaxed">
        <li class="flex items-start gap-3">
          <span class="text-pink-500 mt-1 shrink-0 font-bold" aria-hidden="true">&#8226;</span>
          <div>
            <strong class="text-gray-900">Chinese Lunar Age (虚岁):</strong> Traditional East Asian age counting begins at age 1 at birth and adds 1 year at every Chinese New Year.
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-pink-500 mt-1 shrink-0 font-bold" aria-hidden="true">&#8226;</span>
          <div>
            <strong class="text-gray-900">Lunar Conception Month:</strong> The specific lunar cycle during which conception occurred (e.g., 正月 for Month 1, 腊月 for Month 12).
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-pink-500 mt-1 shrink-0 font-bold" aria-hidden="true">&#8226;</span>
          <div>
            <strong class="text-gray-900">Chinese Zodiac &amp; Ganzhi:</strong> Identifies the Heavenly Stems and Earthly Branches (e.g., 丙午, 乙亥) and the corresponding zodiac animal (e.g., Horse, Pig).
          </div>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-pink-500 mt-1 shrink-0 font-bold" aria-hidden="true">&#8226;</span>
          <div>
            <strong class="text-gray-900">Leap Month Adjustments:</strong> If your conception occurred in a leap month (闰月), our tool flags the intercalary status while matching with the traditional base month.
          </div>
        </li>
      </ul>
    </article>

    <!-- Accuracy and Limitations -->
    <article id="accuracy-limitations" class="space-y-5">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
        Scientific Perspective &amp; Entertainment Notice
      </h2>
      <p class="text-gray-600 leading-relaxed">
        It is essential to understand that the Chinese Gender Predictor is a <strong>cultural tradition and entertainment tool</strong>, not a medical or scientific test.
      </p>
      <p class="text-gray-600 leading-relaxed">
        In human biology, fetal sex is determined strictly at the moment of fertilization by the sperm cell, which contributes either an X chromosome (female) or a Y chromosome (male). Scientific studies have confirmed that the mother's age, conception calendar month, and lunar phases have no influence on chromosomal fertilization.
      </p>
      <p class="text-gray-600 leading-relaxed">
        For reliable medical sex determination, consult your obstetrician or midwife regarding:
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="rounded-xl bg-gray-50 border border-gray-200 p-4 space-y-1.5">
          <h4 class="text-sm font-bold text-gray-900">Cell-Free DNA Blood Test (NIPT)</h4>
          <p class="text-xs text-gray-600 leading-relaxed">
            Analyzes fetal cell-free DNA in the mother's blood to detect Y chromosome presence with &gt;99% clinical accuracy as early as 10 weeks.
          </p>
        </div>
        <div class="rounded-xl bg-gray-50 border border-gray-200 p-4 space-y-1.5">
          <h4 class="text-sm font-bold text-gray-900">Anatomy Ultrasound Scan</h4>
          <p class="text-xs text-gray-600 leading-relaxed">
            A mid-trimester ultrasound performed between 18 and 22 weeks visually evaluates anatomical development and sex characteristics.
          </p>
        </div>
      </div>

      <p class="text-xs text-gray-500 leading-relaxed pt-2">
        Read our full <a href="/medical-disclaimer" class="text-pink-600 hover:text-pink-500 font-semibold underline underline-offset-2 transition-colors">Medical Disclaimer</a> and <a href="/terms-and-conditions" class="text-pink-600 hover:text-pink-500 font-semibold underline underline-offset-2 transition-colors">Terms of Service</a> for complete details.
      </p>
    </article>

    <!-- Just for Fun Callout -->
    <div class="card-light-elevated rounded-2xl p-6 sm:p-8 space-y-4 border-l-4 border-l-pink-500">
      <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2.5">
        <span class="text-2xl" aria-hidden="true">&#127881;</span>
        Just for Fun Disclaimer
      </h3>
      <p class="text-sm text-gray-700 leading-relaxed">
        Predictions generated by this calculator are intended solely for personal entertainment, historical interest, and cultural curiosity. Do not make medical, health, or nursery planning decisions based on these results.
      </p>
    </div>
  </section>

  <!-- Latest from the Blog -->
  <LatestBlogPosts />

  <!-- FAQ Section with Schema Integration -->
  <section id="faq-section" class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-10">
    <div class="text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Frequently Asked Questions</h2>
      <p class="text-gray-600 text-sm">Common questions regarding Chinese lunar gender prediction by conception date</p>
    </div>

    <div class="space-y-4">
      {faqItems.map((faq) => (
        <article class="card-light rounded-xl border border-gray-200 p-5 sm:p-6 space-y-2.5 card-hover">
          <h3 class="text-base sm:text-lg font-semibold text-gray-900">{faq.question}</h3>
          <p class="text-gray-600 leading-relaxed text-sm">{faq.answer}</p>
        </article>
      ))}
    </div>

    <div class="text-center pt-4">
      <a
        href="/faq"
        class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3.5 text-sm font-bold text-gray-700 hover:border-pink-300 hover:text-pink-700 hover:bg-pink-50 shadow-xs transition-all duration-200"
      >
        <span>Explore All Frequently Asked Questions</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Explore Ovulation & Fertility Tools -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-8">
    <div class="text-center space-y-3">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">Explore Fertility &amp; Pregnancy Planning Tools</h2>
      <p class="text-gray-600 text-sm">Planning your pregnancy timeline? Discover calculators for conception and ovulation windows.</p>
    </div>

    <div class="max-w-lg mx-auto">
      <div class="card-light-elevated rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500 to-pink-600 flex items-center justify-center shrink-0 shadow-xs">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h3 class="text-xl font-bold text-gray-900">Accurate Ovulation Calculator</h3>
            <p class="text-sm text-gray-500">Calculate fertile windows and estimated conception dates:</p>
          </div>
        </div>

        <ul class="space-y-2.5 text-sm text-gray-600" role="list">
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-pink-500 shrink-0" aria-hidden="true"></span>
            <span>Ovulation Date &amp; Fertile Window</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-pink-500 shrink-0" aria-hidden="true"></span>
            <span>Estimated Conception Date</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-pink-500 shrink-0" aria-hidden="true"></span>
            <span>Due Date Calculation</span>
          </li>
        </ul>

        <a
          href="https://accurateovulationcalculator.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-base font-semibold text-white btn-primary shadow-lg shadow-pink-500/20 hover:shadow-pink-500/35 transition-all duration-300"
        >
          <span>Visit Accurate Ovulation Calculator</span>
          <svg class="w-5 h-5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <p class="text-center text-xs text-gray-400 leading-relaxed">
          Trusted fertility resources for family planning.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
