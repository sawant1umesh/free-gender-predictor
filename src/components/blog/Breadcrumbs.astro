---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 px-4 rounded-lg bg-gray-50 text-xs sm:text-sm text-gray-500 overflow-x-auto">
  <ol class="flex items-center space-x-2 shrink-0" role="list">
    <li>
      <a href="/" class="hover:text-pink-600 transition-colors font-medium text-gray-600 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        Home
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center space-x-2">
          <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
          {isLast ? (
            <span class="font-semibold text-gray-900 truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-pink-600 transition-colors font-medium text-gray-600 whitespace-nowrap">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
