---
import type { BlogPost } from '../../lib/blog/utils';

interface Props {
  prevPost: BlogPost | null;
  nextPost: BlogPost | null;
}

const { prevPost, nextPost } = Astro.props;
---

{(prevPost || nextPost) && (
  <div class="my-10 pt-8 border-t border-gray-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {prevPost ? (
      <a
        href={`/blog/${prevPost.id}`}
        class="flex flex-col p-4 rounded-xl border border-gray-200 bg-white hover:bg-pink-50/50 hover:border-pink-200 transition-colors group space-y-1"
      >
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-1 group-hover:text-pink-600">
          &larr; Previous Article
        </span>
        <span class="text-sm font-bold text-gray-900 line-clamp-1 group-hover:text-pink-600">
          {prevPost.data.title}
        </span>
      </a>
    ) : <div />}

    {nextPost ? (
      <a
        href={`/blog/${nextPost.id}`}
        class="flex flex-col items-end text-right p-4 rounded-xl border border-gray-200 bg-white hover:bg-pink-50/50 hover:border-pink-200 transition-colors group space-y-1 sm:col-start-2"
      >
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider flex items-center gap-1 group-hover:text-pink-600">
          Next Article &rarr;
        </span>
        <span class="text-sm font-bold text-gray-900 line-clamp-1 group-hover:text-pink-600">
          {nextPost.data.title}
        </span>
      </a>
    ) : <div />}
  </div>
)}
