---
export interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav aria-label="Table of Contents" class="my-8 p-6 rounded-2xl bg-pink-50/60 border border-pink-100 space-y-3">
    <div class="flex items-center gap-2.5 text-pink-700 font-bold text-base border-b border-pink-200/60 pb-3">
      <svg class="w-5 h-5 text-pink-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
      </svg>
      Table of Contents
    </div>
    <ol class="space-y-2 text-sm text-gray-700 max-h-96 overflow-y-auto pr-2" role="list">
      {filteredHeadings.map((heading) => (
        <li class:list={[heading.depth === 3 ? 'ml-4 list-disc marker:text-pink-400' : 'font-medium']}>
          <a
            href={`#${heading.slug}`}
            class="hover:text-pink-600 transition-colors py-0.5 block leading-normal"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
