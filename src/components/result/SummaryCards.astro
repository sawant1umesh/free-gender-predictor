<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
  <!-- Card 1: Best Girl Prediction -->
  <div class="card-light rounded-2xl p-6 sm:p-8 border-l-4 border-l-pink-400 card-hover" style="box-shadow: 0 4px 6px -1px rgba(236, 72, 153, 0.05), 0 2px 4px -2px rgba(236, 72, 153, 0.03);">
