---
import ResultHeader from './ResultHeader.astro';
import SummaryCards from './SummaryCards.astro';
import QuickStats from './QuickStats.astro';
import DisclaimerNotice from './DisclaimerNotice.astro';
---

<section
  id="prediction-result-section"
  aria-live="polite"
  class="hidden opacity-0 translate-y-6 transition-all duration-700 ease-out py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto space-y-12"
>
  <!-- Section 1: Header -->
  <ResultHeader />

  <!-- Section 2: Best Girl & Best Boy Summary Cards -->
  <SummaryCards />

  <!-- Section 3: Quick Statistics -->
  <QuickStats />

  <!-- Section 4: Next Year CTA -->
  <div class="flex justify-center pt-4">
    <button
      type="button"
      id="next-year-btn"
      disabled
      aria-label="Check prediction for the next year"
      class="inline-flex items-center gap-2 rounded-xl font-semibold text-white shadow-lg shadow-pink-500/20 transition-all duration-300 hover:shadow-pink-500/35 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2 focus:ring-offset-white disabled:opacity-50 disabled:cursor-not-allowed disabled:active:scale-100 btn-primary"
    >
      <span class="relative z-10 flex items-center justify-center gap-2.5 px-6 py-3 text-sm font-semibold transition-all duration-300">
        <span id="next-year-spinner" class="hidden animate-spin h-4 w-4 text-white">
          <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
        <span id="next-year-text">Check Prediction for Next Year</span>
        <svg class="w-4 h-4 text-indigo-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </button>
  </div>

  <!-- Section 5: Information Notice -->
  <DisclaimerNotice />
</section>

<script>
  import type { PredictionApiResponse } from '../../lib/api';

  const MONTH_NAMES_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  let lastBirthDate: string | null = null;
  let currentYear: number = 2026;

  function formatDateStr(dateStr: string): string {
    const [y, m, d] = dateStr.split('-');
    return `${MONTH_NAMES_SHORT[parseInt(m, 10) - 1]} ${d}, ${y}`;
  }

  function formatDateRange(range: string): string {
    const parts = range.split(/ ~ | to /);
    if (parts.length !== 2) return range;

    return `${formatDateStr(parts[0])} \u2013 ${formatDateStr(parts[1])}`;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const resultSection = document.getElementById('prediction-result-section');

    // Header elements
    const resTargetYear = document.getElementById('res-target-year');
    const resMotherDob = document.getElementById('res-mother-dob');
    const resLunarAge = document.getElementById('res-lunar-age');

    // Girl Card elements
    const girlScoreBadge = document.getElementById('girl-score-badge');
    const girlMonthName = document.getElementById('girl-month-name');
    const girlDateRange = document.getElementById('girl-date-range');
    const girlRecommendation = document.getElementById('girl-recommendation');

    // Boy Card elements
    const boyScoreBadge = document.getElementById('boy-score-badge');
    const boyMonthName = document.getElementById('boy-month-name');
    const boyDateRange = document.getElementById('boy-date-range');
    const boyRecommendation = document.getElementById('boy-recommendation');

    // Stats elements
    const statTotalMonths = document.getElementById('stat-total-months');
    const statTrend = document.getElementById('stat-trend');
    const statGirlMonth = document.getElementById('stat-girl-month');
    const statBoyMonth = document.getElementById('stat-boy-month');

    // Next Year button elements
    const nextYearBtn = document.getElementById('next-year-btn') as HTMLButtonElement | null;
    const nextYearSpinner = document.getElementById('next-year-spinner');
    const nextYearText = document.getElementById('next-year-text');

    function setNextYearLoading(isLoading: boolean) {
      if (!nextYearBtn || !nextYearSpinner || !nextYearText) return;
      nextYearBtn.disabled = isLoading;
      if (isLoading) {
        nextYearSpinner.classList.remove('hidden');
        nextYearText.textContent = 'Calculating...';
      } else {
        nextYearSpinner.classList.add('hidden');
        nextYearText.textContent = 'Check Prediction for Next Year';
      }
    }

    window.addEventListener('gender-prediction-updated', (event: Event) => {
      const customEvent = event as CustomEvent<PredictionApiResponse>;
      const response = customEvent.detail;

      if (!response || !response.success || !resultSection) return;

      const { hero, bestGirl, bestBoy } = response.viewModels;
      const raw = response.raw;

      // Store state for Next Year feature
      lastBirthDate = raw.motherInfo.gregorianBirthDate;
      currentYear = hero.targetYear;

      // 1. Update Header
      if (resTargetYear) resTargetYear.textContent = String(hero.targetYear);
      if (resMotherDob) resMotherDob.textContent = hero.motherBirthDateFormatted;
      if (resLunarAge) resLunarAge.textContent = String(hero.motherLunarAge);

      // 2. Update Girl Card
      if (bestGirl) {
        if (girlScoreBadge) girlScoreBadge.textContent = `${bestGirl.scorePercentage}% Match`;
        if (girlMonthName) girlMonthName.textContent = `Lunar Month ${bestGirl.lunarMonth}`;
        if (girlDateRange) girlDateRange.textContent = formatDateRange(bestGirl.gregorianDateRange);
        if (girlRecommendation) girlRecommendation.textContent = bestGirl.recommendationDescription;
      }

      // 3. Update Boy Card
      if (bestBoy) {
        if (boyScoreBadge) boyScoreBadge.textContent = `${bestBoy.scorePercentage}% Match`;
        if (boyMonthName) boyMonthName.textContent = `Lunar Month ${bestBoy.lunarMonth}`;
        if (boyDateRange) boyDateRange.textContent = formatDateRange(bestBoy.gregorianDateRange);
        if (boyRecommendation) boyRecommendation.textContent = bestBoy.recommendationDescription;
      }

      // 4. Update Quick Stats
      if (statTotalMonths) statTotalMonths.textContent = String(raw.months.length);
      if (statTrend) statTrend.textContent = hero.dominantGenderBadgeText;
      if (statGirlMonth && bestGirl) statGirlMonth.textContent = `Lunar Month ${bestGirl.lunarMonth}`;
      if (statBoyMonth && bestBoy) statBoyMonth.textContent = `Lunar Month ${bestBoy.lunarMonth}`;

      // 5. Enable Next Year button
      setNextYearLoading(false);

      // 6. Reveal result section with smooth CSS transition
      resultSection.classList.remove('hidden');

      // Request animation frame for smooth opacity & transform transition
      requestAnimationFrame(() => {
        resultSection.classList.remove('opacity-0', 'translate-y-6');
        resultSection.classList.add('opacity-100', 'translate-y-0');

        // Smooth scroll to top of result section
        resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Next Year button click handler
    nextYearBtn?.addEventListener('click', () => {
      if (!lastBirthDate || nextYearBtn?.disabled) return;

      const nextYear = currentYear + 1;
      setNextYearLoading(true);

      setTimeout(async () => {
        try {
          const { generatePrediction } = await import('../../lib/api');
          const response = generatePrediction({
            motherBirthDate: lastBirthDate!,
            targetYear: nextYear,
          });

          window.dispatchEvent(
            new CustomEvent('gender-prediction-updated', {
              detail: response,
            })
          );
        } catch (err: any) {
          setNextYearLoading(false);
          console.error('Next year prediction failed:', err);
        }
      }, 300);
    });
  });
</script>
