---
// QuickStats.astro
---

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
  <div class="rounded-xl glass-panel p-4 text-center border border-white/5">
    <div class="text-xs text-slate-400 font-medium">Months Analysed</div>
    <div id="stat-total-months" class="text-2xl font-extrabold text-white mt-1">12</div>
    <div class="text-[10px] text-slate-500 mt-0.5">Lunar Months</div>
  </div>

  <div class="rounded-xl glass-panel p-4 text-center border border-white/5">
    <div class="text-xs text-slate-400 font-medium">Dominant Trend</div>
    <div id="stat-trend" class="text-base sm:text-lg font-bold text-indigo-300 mt-1 truncate">--</div>
    <div class="text-[10px] text-slate-500 mt-0.5">Year Overview</div>
  </div>

  <div class="rounded-xl glass-panel p-4 text-center border border-white/5">
    <div class="text-xs text-slate-400 font-medium">Best Girl Month</div>
    <div id="stat-girl-month" class="text-lg font-bold text-pink-300 mt-1">--</div>
    <div class="text-[10px] text-slate-500 mt-0.5">Optimal Window</div>
  </div>

  <div class="rounded-xl glass-panel p-4 text-center border border-white/5">
    <div class="text-xs text-slate-400 font-medium">Best Boy Month</div>
    <div id="stat-boy-month" class="text-lg font-bold text-indigo-300 mt-1">--</div>
    <div class="text-[10px] text-slate-500 mt-0.5">Optimal Window</div>
  </div>
</div>
