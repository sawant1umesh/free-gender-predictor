---
import CalculatorForm from './CalculatorForm.astro';
---

<section class="relative min-h-[90vh] flex items-center justify-center pt-16 pb-20 overflow-hidden bg-[#0b0f19]">
  <!-- Ambient background glow accents -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[350px] h-[350px] bg-purple-600/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-[300px] h-[300px] bg-pink-600/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & Trust Indicators -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-indigo-300 backdrop-blur-md">
          <span class="text-amber-400">✦</span>
          <span>2026 Chinese Lunar Calendar Updated</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1] text-white">
          Chinese Gender <br class="hidden sm:inline" />
          <span class="gradient-accent-text">Predictor</span>
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Plan your pregnancy using the traditional Chinese Gender Prediction Calendar.
        </p>

        <!-- Trust Indicators -->
        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-6 sm:gap-8 text-xs font-medium text-slate-400">
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
            <span>Instant Analysis</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
            <span>Privacy First</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-purple-400"></div>
            <span>100% Free & Private</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Calculator Card -->
      <div class="lg:col-span-5 w-full">
        <CalculatorForm />
      </div>

    </div>
  </div>
</section>
