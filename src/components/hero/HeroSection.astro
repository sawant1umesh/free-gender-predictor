---
import CalculatorForm from './CalculatorForm.astro';
---

<section class="relative min-h-[92vh] flex items-center justify-center pt-20 pb-24 overflow-hidden bg-gradient-to-b from-pink-50 via-white to-white">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">

      <!-- Left Column: Copy & Trust Indicators -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-semibold tracking-wide bg-pink-100 border border-pink-200 text-pink-700">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-pink-500"></span>
          </span>
          <span>2026 Chinese Gender Prediction Chart Updated</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight leading-[1.08] text-gray-900">
          Chinese Gender<br class="hidden sm:inline" />
          <span class="gradient-accent-text">Predictor</span>
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-xl text-gray-500 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Use the free <strong>Chinese Gender Predictor</strong> to estimate your baby's gender based on the traditional Qing Gong Biao lunar calendar chart.
        </p>

        <!-- Trust Indicators -->
        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-5 sm:gap-7">
          <div class="flex items-center gap-2.5 text-sm text-gray-500">
            <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-green-100 border border-green-200">
              <svg class="w-4 h-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <span>Instant Analysis</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-500">
            <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-100 border border-blue-200">
              <svg class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <span>Privacy First</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-500">
            <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-purple-100 border border-purple-200">
              <svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <span>100% Free & Private</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Hero Calculator Card -->
      <div class="lg:col-span-5 w-full">
        <CalculatorForm />
      </div>

    </div>
  </div>
</section>
