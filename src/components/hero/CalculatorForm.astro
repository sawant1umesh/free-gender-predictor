---
// CalculatorForm.astro
---

<div class="card-light-elevated rounded-2xl p-6 sm:p-8 w-full max-w-md mx-auto">
  <div class="flex items-center justify-between mb-7 pb-5 border-b border-gray-100">
    <div>
      <h2 class="text-xl font-bold text-gray-900 tracking-tight">Gender Predictor</h2>
      <p class="text-xs text-gray-500 mt-1 font-medium">Calculate using Chinese Lunar Calendar</p>
    </div>
    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-pink-50 text-pink-700 border border-pink-200">
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-pink-500"></span>
      </span>
      2026 Ready
    </span>
  </div>

  <form id="calculator-form" novalidate class="space-y-5">
    <div>
      <label for="mother-dob" class="block text-sm font-semibold text-gray-700 mb-2.5">
        Mother's Date of Birth <span class="text-pink-500" aria-hidden="true">*</span>
      </label>
      <div class="relative rounded-xl">
        <input
          type="date"
          id="mother-dob"
          name="motherDob"
          required
          aria-required="true"
          aria-invalid="false"
          aria-describedby="dob-error-msg"
          class="w-full bg-white border border-gray-200 text-gray-900 text-base rounded-xl px-4 py-3.5 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-pink-500/40 focus:border-pink-400 transition-all duration-200 hover:border-gray-300"
        />
      </div>
      <p id="dob-error-msg" aria-live="polite" class="hidden mt-2 text-xs font-medium text-red-500 flex items-center gap-1.5">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span id="dob-error-text">Please enter a valid birth date.</span>
      </p>
      <div id="age-error-msg" aria-live="polite" class="hidden mt-3 rounded-xl bg-amber-50 border border-amber-200 p-4">
        <div class="flex items-start gap-3">
          <div class="p-1.5 rounded-full bg-amber-100 text-amber-600 shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-amber-800">You must be at least 18 years old.</h3>
            <p class="text-xs text-amber-700 mt-1 leading-relaxed">This calculator is intended for adults aged 18 years and older. Please enter a valid date of birth.</p>
          </div>
        </div>
      </div>
    </div>

    <button
      type="submit"
      id="submit-btn"
      class="w-full relative group overflow-hidden rounded-xl font-semibold text-white shadow-lg shadow-pink-500/20 transition-all duration-300 hover:shadow-pink-500/35 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2 focus:ring-offset-white btn-primary"
    >
      <span class="relative z-10 flex items-center justify-center gap-2.5 rounded-[11px] px-6 py-3.5 text-base font-semibold transition-all duration-300">
        <span id="btn-spinner" class="hidden animate-spin h-5 w-5 text-white">
          <svg class="w-full h-full" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </span>
        <span id="btn-text">Show My Prediction</span>
        <svg id="btn-arrow" class="w-5 h-5 text-white/80 group-hover:translate-x-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    </button>

    <div class="flex items-center justify-center gap-2 pt-2 text-xs text-gray-400 font-medium">
      <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>No personal data is stored. 100% private.</span>
    </div>
  </form>

  <div id="result-feedback-container" class="hidden mt-6 pt-5 border-t border-gray-100">
    <div id="success-banner" class="rounded-xl bg-green-50 border border-green-200 p-4">
      <div class="flex items-start gap-3">
        <div class="p-1.5 rounded-full bg-green-100 text-green-600 shrink-0 mt-0.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-green-800" id="result-headline">Prediction Generated</h3>
          <p class="text-xs text-gray-600 mt-1 leading-relaxed" id="result-detail"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { isEligibleMotherAge } from '../../lib/calendar/validation';

  let preloaded = false;

  function preloadEngine() {
    if (preloaded) return;
    preloaded = true;
    import('../../lib/api').catch(() => { preloaded = false; });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('calculator-form') as HTMLFormElement | null;
    const input = document.getElementById('mother-dob') as HTMLInputElement | null;
    const errorMsg = document.getElementById('dob-error-msg');
    const errorText = document.getElementById('dob-error-text');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnSpinner = document.getElementById('btn-spinner');
    const btnArrow = document.getElementById('btn-arrow');
    const btnText = document.getElementById('btn-text');
    const feedbackContainer = document.getElementById('result-feedback-container');
    const resultHeadline = document.getElementById('result-headline');
    const resultDetail = document.getElementById('result-detail');
    const ageErrorMsg = document.getElementById('age-error-msg');

    if (!form || !input || !submitBtn) return;

    const now = new Date();
    const todayStr = now.toISOString().split('T')[0];
    input.setAttribute('max', todayStr);

    // Preload during idle time instead of on first interaction
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => preloadEngine(), { timeout: 2000 });
    } else {
      setTimeout(() => preloadEngine(), 1000);
    }

    function showError(message: string) {
      if (errorMsg && errorText && input) {
        errorText.textContent = message;
        errorMsg.classList.remove('hidden');
        input.setAttribute('aria-invalid', 'true');
        input.classList.add('border-red-400', 'focus:ring-red-400/50');
      }
    }

    function clearError() {
      if (errorMsg && input) {
        errorMsg.classList.add('hidden');
        input.setAttribute('aria-invalid', 'false');
        input.classList.remove('border-red-400', 'focus:ring-red-400/50');
      }
      if (ageErrorMsg) {
        ageErrorMsg.classList.add('hidden');
      }
    }

    function setLoading(isLoading: boolean) {
      if (submitBtn && btnSpinner && btnText && btnArrow && input) {
        submitBtn.disabled = isLoading;
        input.disabled = isLoading;
        if (isLoading) {
          btnSpinner.classList.remove('hidden');
          btnArrow.classList.add('hidden');
          btnText.textContent = 'Calculating...';
          submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
        } else {
          btnSpinner.classList.add('hidden');
          btnArrow.classList.remove('hidden');
          btnText.textContent = 'Show My Prediction';
          submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
        }
      }
    }

    input.addEventListener('input', clearError);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();

      const value = input.value.trim();

      if (!value) {
        showError("Please enter Mother's Date of Birth.");
        input.focus();
        return;
      }

      const dateParts = value.split('-');
      if (dateParts.length !== 3) {
        showError("Please enter a valid birth date (YYYY-MM-DD).");
        input.focus();
        return;
      }

      const inputDate = new Date(value);
      if (isNaN(inputDate.getTime())) {
        showError("The entered date is invalid. Please check the month and day.");
        input.focus();
        return;
      }

      const today = new Date(now.getTime());
      today.setHours(23, 59, 59, 999);
      if (inputDate > today) {
        showError("Birth date cannot be in the future.");
        input.focus();
        return;
      }

      const targetYear = new Date().getFullYear();
      const targetDateStr = `${targetYear}-01-01`;
      if (!isEligibleMotherAge(value, targetDateStr)) {
        if (feedbackContainer) feedbackContainer.classList.add('hidden');
        if (ageErrorMsg) ageErrorMsg.classList.remove('hidden');
        input.focus();
        return;
      }

      setLoading(true);

      try {
        const { generatePrediction } = await import('../../lib/api');
        const response = generatePrediction({
          motherBirthDate: value,
          targetYear: 2026,
        });

        setLoading(false);

        if (feedbackContainer && resultHeadline && resultDetail) {
          resultHeadline.textContent = `2026 Analysis for Mother (Lunar Age ${response.viewModels.hero.motherLunarAge})`;
          resultDetail.textContent = `Dominant trend: ${response.viewModels.hero.headlineSummary}.`;
          feedbackContainer.classList.remove('hidden');
        }

        window.dispatchEvent(
          new CustomEvent('gender-prediction-updated', {
            detail: response,
          })
        );
      } catch (err: any) {
        setLoading(false);
        showError(err.message || 'Failed to generate prediction. Please try again.');
      }
    });
  });
</script>
